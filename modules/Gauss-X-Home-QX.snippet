# Count-only X home probe. All responses pass through unchanged.
hostname = api.x.com, api.twitter.com, x.com, twitter.com
^https:\/\/(?:api\.(?:x|twitter)\.com|(?:x|twitter)\.com)\/(?:i\/api\/)?graphql\/[\w-]+\/(?:HomeTimeline|HomeLatestTimeline)\/?(?:\?|$) url script-response-body https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/23f6d3aef346721356ac8ab18881b71233095a5d/scripts/x-home-probe-qx.js
