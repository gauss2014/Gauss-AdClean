# X home only: promoted entries; keep ordinary tweets and pagination cursors.
hostname = api.x.com, api.twitter.com, x.com, twitter.com
^https:\/\/(?:api\.(?:x|twitter)\.com|(?:x|twitter)\.com)\/(?:i\/api\/)?graphql\/[\w-]+\/(?:HomeTimeline|HomeLatestTimeline)\/?(?:\?|$) url script-response-body https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/3a542e5729fc925978384fd88cfdd5e11ad6255b/scripts/x-home-ads-qx.js
