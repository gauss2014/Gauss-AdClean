http-response-jq ^https?:\/\/gql(-fed)?\.reddit\.com 'walk(if type == "object" then (if (.commentsPageAds | type == "array") then .commentsPageAds = [] else . end) | (if ((.node | type == "object") and (.node.cells | type == "array") and (.node.cells | any(.__typename? == "AdMetadataCell" or .isAdPost? == true))) then empty else . end) | (if ((.node | type == "object") and (.node.adPayload | type == "object")) then empty else . end) | (if .__typename == "AdPost" then empty else . end) else . end)'

[Script]
# Component: Gauss-AdClean-Advanced
# Audited first-party script pinned to this release, not upstream executable code.
gauss-xianyu-splash = type=http-response,pattern=^https?:\/\/(?:(?:(?:g|guide)-)?acs|gw|h5api)\.m\.(?:goofish|taobao)\.com\/(?:gw|h5)\/mtop\.taobao\.(?:idlecommerce\.splash\.(?:async\.)?ads|idle\.splash\.ads)(?:\/|\?|$),requires-body=1,max-size=262144,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.4.1/scripts/xianyu-splash-cleanup.js,timeout=5

# Component: Gauss-JD-Conservative
# 使用已在当前手机环境验证可执行的响应脚本；仅记录接口与修改计数，不记录响应值
# 新协议的 functionId 可能不在 URL；脚本内严格区分开屏特征与既有 UI 清理范围。
JD_Cleanup_Main = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/(?:client\.action|api)(?:\?[^#]*)?$,requires-body=1,max-size=1048576,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.4.2/scripts/jd-response-cleanup.js,timeout=5
JD_Cleanup_Wallet = type=http-response,pattern=^https?:\/\/ms\.jr\.jd\.com\/gw2\/generic\/(MyWalletS\/newh5\/m\/(myWalletIndex|myWalletIndexAsyncData)|wealth-marketing-component\/h5\/m\/walletEntryQuery|jkActivity\/newh5\/m\/queryDeliveryChannelInfo)(?:\?|$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.3.4/scripts/jd-response-cleanup.js

# Component: Gauss-YouTube-Local
