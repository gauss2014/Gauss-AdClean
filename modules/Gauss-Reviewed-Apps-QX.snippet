# Native-only subset of ddgksf2013 BiliBiliAds/Applet and ZenmoFeiShi MT.
# Keep existing search, homepage and account handlers; no third-party scripts.
hostname = api.bilibili.com, api.biliapi.net, api.live.bilibili.com, manga.bilibili.com, api.blibee.com, ucmp.sf-express.com, wx.mygolbs.com, feedguess.meituan.com, apimobile.meituan.com, mop.meituan.com, assistify.meituan.com, www.bbkj.work, wx.wxqqurl.cn, wp3.lobdol.cn, awg.enmonster.com, jabi.coding.net, api.bspapp.com, 3dd0be8a-54fe-43ff-a0e7-f670c4f20432.bspapp.com, *.tslt.xyz, g.syshhc.top, c.jxjt888.top, www.laoguikeji.cn, qj.bpojie.com, b.tslt.xyz, m.xgjyouhui.com, www.freeheikeji.cn, xcx.xianbaow.com, *.smkj33.top, *.ddly666.top, hkj178.com, a.jxjt888.top, lysl2020.com, www.i3zh.com, iosoi.cn, jt.jxjt888.top, gjsx.vip, d.syshhc.top, gz.gongzijx.com, tvapp.guilaile.cn, www.benbenfx.xyz, 4thdimension.top, tan.ipnas.ltd, httpdns.meituan.com, httpdnsvip.meituan.com, httpdnsmultiapi.meituan.com, httpdnsmultiapivip.meituan.com
^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.(?:app\.(?:view\.v1\.View\/(?:View|TFInfo)|viewunite\.v1\.View\/View|dynamic\.v2\.Dynamic\/DynAll)|community\.service\.dm\.v1\.DM\/DmView)(?:\?|$) url script-response-body https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/38ff9293027c6887556f7a5cbc5ca3aef351b957/scripts/bili-search-qx.js
^https:\/\/app\.bilibili\.com\/x\/v\d+\/search\/defaultwords\/?(?:\?|$) url reject-dict
^https:\/\/(?:app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default(?:\?|$) url reject-200
^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "object" then .data = {type:"history",title:"搜索历史",search_hotword_revision:2} else . end'
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d+\/ecommerce-user\/get_shopping_info\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "object" then .data = {shopping_card_detail:{},bubbles_detail:{},recommend_card_detail:{},selected_goods:{},h5jump_popup:[]} else . end'
^https:\/\/api\.(?:bilibili\.com|biliapi\.net)\/pgc\/page\/(?:bangumi|cinema\/tab)\/?(?:\?|$) url jsonjq-response-body '(.result?.modules[]? | objects) |= (if (.items | type) == "array" then . as $m | if ([1283,241,1441,1284] | index($m.module_id)) != null or ((.style // "") | startswith("tip")) then .items=[] elif ((.style // "") | startswith("banner")) then .items |= map(select((.link? // "") | contains("play"))) elif ((.style // "") | startswith("function")) then .items |= map(select((.blink? // "") | contains("bilibili.com") | not)) else . end else . end)'
^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\/?(?:\?|$) url jsonjq-response-body 'if (.data.online? | type) == "object" then .data.online.icon="" else . end'
^https:\/\/app\.bilibili\.com\/x\/v2\/account\/mine\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "object" then del(.data.vip_section_v2,.data.vip_section,.data.live_tip,.data.answer) | (.data.sections_v2[]? | objects) |= (del(.button,.be_up_title,.tip_icon,.tip_title) | (.items? | arrays) |= map(select(.id as $id | [396,397,398,399,407,410,402,404,425,426,427,428,430,432,433,434,494,495,496,497,500,501,2830,3072,3084] | index($id) != null))) else . end'
^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "object" then (.data.tab? | arrays) |= map(select(.id as $i | [39,40,774,545,41,151] | index($i) != null)) | (.data.top? | arrays) |= map(select(.id == 481)) | (.data.bottom? | arrays) |= map(select(.id as $i | [177,178,179,181,102,104,106,486,488,489] | index($i) != null)) else . end'
^https?:\/\/(?:api\.blibee\.com|ucmp\.sf-express\.com|www\.bbkj\.work|wx\.wxqqurl\.cn|wp3\.lobdol\.cn|awg\.enmonster\.com|wx\.mygolbs\.com|jabi\.coding\.net|api\.bspapp\.com|3dd0be8a-54fe-43ff-a0e7-f670c4f20432\.bspapp\.com|[a-z0-9-]+\.tslt\.xyz|g\.syshhc\.top|c\.jxjt888\.top|www\.laoguikeji\.cn|qj\.bpojie\.com|b\.tslt\.xyz|m\.xgjyouhui\.com|www\.freeheikeji\.cn|xcx\.xianbaow\.com|[a-z0-9-]+\.smkj33\.top|[a-z0-9-]+\.ddly666\.top|hkj178\.com|a\.jxjt888\.top|lysl2020\.com|www\.i3zh\.com|iosoi\.cn|jt\.jxjt888\.top|gjsx\.vip|d\.syshhc\.top|gz\.gongzijx\.com|tvapp\.guilaile\.cn|www\.benbenfx\.xyz|4thdimension\.top|tan\.ipnas\.ltd)\/wp-json\/[\w-]+\/(?:mp\/)?v\d+\/posts(?:[/?]|$) url jsonjq-response-body 'walk(if type == "object" then with_entries(if ((.key == "Ad" or .key == "excitationAd") and (.value | type) == "string") then .value="0" elif (.key == "ad" and .value == true) then .value=false elif (.key == "AdId" or .key == "adid") then .value="" else . end) else . end)'
^https?:\/\/(?:httpdns|httpdnsvip|httpdnsmultiapi|httpdnsmultiapivip)\.meituan\.com\/ url reject
^http:\/\/103\.37\.155\.60\/fetch(?:[/?]|$) url reject
^https:\/\/api\.bilibili\.com\/(?:pgc\/activity\/deliver\/material\/receive|x\/vip\/ads\/material\/report|pgc\/season\/player\/(?:ogv\/)?cards)\/?(?:\?|$) url reject-dict
^https:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d+\.Comic\/(?:Flash|ListFlash|GetActivityTab)\/?(?:\?|$) url reject-dict
^https:\/\/api\.(?:bilibili\.com|biliapi\.net)\/pgc\/season\/app\/related\/recommend\/?(?:\?|$) url jsonjq-response-body 'if (.result.cards? | type) == "array" then .result.cards |= map(select((.type? | tostring) != "2")) else . end'
^https:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed\/?(?:\?|$) url jsonjq-response-body 'if (.data.card_list? | type) == "array" then .data.card_list |= map(select(.card_type? != "banner_v1")) else . end'
^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "object" then del(.data.activity_banner_info) | if (.data.shopping_info? | type) == "object" then .data.shopping_info.is_show = 0 else . end else . end'
^https:\/\/api\.blibee\.com\/cvsnotify-api\/cvs\/notify\/app\/banner\/v\d+\/?(?:\?|$) url reject-200
^https:\/\/ucmp\.sf-express\.com\/proxy\/operation-platform\/info-flow-adver\/query\/?(?:\?|$) url reject-200
^https:\/\/wx\.mygolbs\.com\/WxBusServer\/ApiData\.do(?:\?|$) url jsonjq-response-body 'walk(if type == "object" then with_entries(if ((.key == "Ad" or .key == "Ad_ab") and .value == 1) then .value = 0 else . end) else . end)'
^https:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(?:gwc_feed1_2265|personalcenter_2154)\/?(?:\?|$) url jsonjq-response-body 'if (.data? | type) == "array" then .data = [] | .bottom = true | if (.ext | type) == "object" then .ext.forbidByExp = true else .ext = {forbidByExp:true} end else . end'
^https:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword\/?(?:\?|$) url jsonjq-response-body '(.searchIntroduceResponse? | (.defaultWordRes?.defaultWordItems?, .HotWordInfos?) | arrays) |= []'
^https:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/?(?:\?|$) url jsonjq-response-body '(.data?.segmentsV2? | arrays) |= map(if (.hotwordSegments? | type) == "array" and (.hotwordSegments | length) > 0 then .hotwordSegments |= map(select(.pageName? != "EntranceHotwordsV2Hotwords" and .pageName? != "EntranceHotwordsV2ContentCard")) | select(.hotwordSegments | length > 0) else . end) | (.data?.aiSearchBubble?.bubbleTexts? | arrays) |= []'
^https:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig\/?(?:\?|$) url jsonjq-response-body '(.data? | strings) |= (. as $old | try (fromjson | if (.skills? | type) == "object" then .skills = {} | tojson else $old end) catch $old)'
^https:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry\/?(?:\?|$) url jsonjq-response-body '((., .data?) | (.resourcesMap?, .resource?) | .topBannerArea? | arrays) |= []'
^https:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture\/?(?:\?|$) url jsonjq-response-body '((., .data?) | (.resourcesMap?, .resource?) | .startupPicArea? | arrays) |= []'
