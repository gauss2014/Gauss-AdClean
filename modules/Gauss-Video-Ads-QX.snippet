# Request rules precede the existing YouTube response-body handlers.
hostname = -redirector*.googlevideo.com, *.googlevideo.com, app.bilibili.com, grpc.biliapi.net
^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll(?:\?|$) url script-response-body https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/99d6d85a85f0705e18337d1c802ec8a2d82ddc4b/scripts/bili-search-qx.js
^https?:\/\/(?!redirector)[\w-]+\.googlevideo\.com\/(?!(?:dclk_video_ads|videoplayback)(?:[/?]|$))[^?#]*\?(?:[^&#]*&)*oad(?:[=&]|$) url reject-200
^(https?:\/\/(?!redirector)[\w-]+\.googlevideo\.com\/(?!dclk_video_ads)[^?#]*\?[^#]+?)&ctier=L(&[^#]+?),ctier,([^#]+)$ url 302 $1$2,$3
^https:\/\/app\.bilibili\.com\/x\/v\d+\/splash\/(?:list|show|brand\/list)(?:\?|$) url reject-200
^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index(?:\?|$) url jsonjq-response-body 'if (.data.items | type) == "array" then .data.items |= map(select(if type == "object" then (.ad_info == null and .card_goto != "ad_av" and .card_goto != "ad_web") else true end)) else . end'
^https:\/\/app\.bilibili\.com\/x\/v2\/search(?:\/type)?(?:\?|$) url jsonjq-response-body 'def adcard: if type != "object" then false else (.is_ad == true or .is_ad == 1 or .goto == "cm" or .goto == "ad_av" or .goto == "ad_web" or (.ad_info | if type == "object" then length > 0 else false end) or any(.badge, .badge_style.text?, .badge.text?; . == "广告" or . == "廣告")) end; if .code? == 0 and (.data | type) == "object" then .data |= (reduce ("item","items") as $k (.; if (.[$k] | type) == "array" then .[$k] |= map(select(adcard | not)) else . end)) else . end'
