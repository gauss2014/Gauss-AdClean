#!name=Gauss JD Conservative
#!desc=京东保守去广告与界面精简：仅处理明确广告、活动弹窗、游戏和钱包营销入口；不修改会员、登录、支付或钱包核心数据
#!author=Gauss2014 local audit
#!version=0.4.1
#!homepage=https://github.com/Gauss2014/Gauss-AdClean
#!url=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/main/components/Gauss-JD-Conservative.sgmodule

[URL Rewrite]
# 京东广告投放与明确广告素材
^https?:\/\/(bdsp-x|dsp-x)\.jd\.com\/adx\/ - reject-200
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryMaterialAdverts(?:&|$) - reject-200
^https?:\/\/img\d+\.360buyimg\.com\/jddjadvertise\/ - reject

# 京东主App：冷启动弹窗和首页“二楼”
^https?:\/\/api\.m\.jd\.com\/api\?functionId=delivery_show(?:&|$) - reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=home_launchConfig(?:&|$) - reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(queryPagePopWindow|secondFloor)(?:&|$) - reject-dict

# 京东金融：仅启动图和广告信息，不拦截首页数据、导航、登录或支付
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/(new)?na\/m\/getLoadingPicture(?:\?|$) - reject-200
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/app\/(new)?na\/m\/getLaunchImageList(?:\?|$) - reject-dict
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/base\/(new)?na\/m\/adInfo(?:\?|$) - reject-200

[Script]
# 使用已在当前手机环境验证可执行的响应脚本；仅记录接口与修改计数，不记录响应值
JD_Cleanup_Game = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/(client\.action|api)$,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.3.4/scripts/jd-response-cleanup.js
JD_Cleanup_Home = type=http-response,pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(welcomeHome|personinfoBusiness|getTabHomeInfo)(?:&|$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.3.4/scripts/jd-response-cleanup.js
JD_Cleanup_Wallet = type=http-response,pattern=^https?:\/\/ms\.jr\.jd\.com\/gw2\/generic\/(MyWalletS\/newh5\/m\/(myWalletIndex|myWalletIndexAsyncData)|wealth-marketing-component\/h5\/m\/walletEntryQuery|jkActivity\/newh5\/m\/queryDeliveryChannelInfo)(?:\?|$),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Gauss2014/Gauss-AdClean/v0.3.4/scripts/jd-response-cleanup.js

[MITM]
hostname = %APPEND% api.m.jd.com,bdsp-x.jd.com,dsp-x.jd.com,img*.360buyimg.com,ms.jr.jd.com
